{
  "name": "lyz-robotwin",

  "dockerFile": "Dockerfile",
  "build": {
    "target": "target",
    "options": ["--network=host", "--progress=plain"],
    "args": {
      "ROBOTWIN_REPO": "https://github.com/horserr/RoboTwin.git",
      "HTTP_PROXY": "http://127.0.0.1:7890",
      "HTTPS_PROXY": "http://127.0.0.1:7890",
      "http_proxy": "http://127.0.0.1:7890",
      "https_proxy": "http://127.0.0.1:7890"
    }
  },

  "runArgs": [
    // note: cannot use host network for wslc
    // use this domain for windows host: host.docker.internal
    // "--network=host"
    "--gpus",
    "all",
    "--network=host"
  ],

  "containerEnv": {
    // TODO change this for the server
    // "CUDA_VISIBLE_DEVICES": "1",
    "UV_PROJECT_ENVIRONMENT": "/opt/venv",

    "GITHUB_USERNAME": "horserr",
    "GH_TOKEN": "${localEnv:GH_TOKEN}",
    "GITHUB_ACCESS_TOKEN": "${localEnv:GH_TOKEN}"
  },

  "remoteUser": "root",
  "workspaceFolder": "/root/workspace/RoboTwin",
  "workspaceMount": "source=${localWorkspaceFolder},target=/root/workspace/RoboTwin,type=bind,consistency=cached",
  "mounts": [
    {
      "source": "uv-cache-volume",
      "target": "/root/.cache/uv",
      "type": "volume"
    },
    {
      "source": "robotwin-venv-volume",
      "target": "/opt/venv",
      "type": "volume"
    }
  ],

  "customizations": {
    "vscode": {
      "settings": {
        "files.eol": "\n",
        "http.useLocalProxyConfiguration": false
      },
      "extensions": [
        "FanaticPythoner.better-todo-tree",
        "ms-python.python",
        "charliermarsh.ruff",
        "the0807.uv-toolkit",
        "fill-labs.dependi",
        "meta.pyrefly"
      ]
    }
  },

  "features": {
    // "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },

  "onCreateCommand": [
    "${containerWorkspaceFolder}/.devcontainer/initialize.sh",
    "${containerWorkspaceFolder}/.devcontainer/onCreate.sh"
  ],

  "postCreateCommand": "${containerWorkspaceFolder}/.devcontainer/postCreate.sh"
}
